# Copy to .env.production and fill all values
NODE_ENV=production
PORT=5000

# Domain setup
MAIN_DOMAIN=rioassetmanagement.net
FRONTEND_URL=https://web.rioassetmanagement.net
BACKEND_URL=https://web.rioassetmanagement.net
API_BASE_URL=https://web.rioassetmanagement.net/api

# Subdomains tenants cannot register (comma-separated). Must include platform hosts.
RESERVED_SUBDOMAINS=web,www,api,pressanaorg

# Required app secrets/infra
# Docker Postgres (alm_db) does not use SSL — always add ?sslmode=disable
# Or set DB_SSL=false explicitly
DB_SSL=false

# --- Direct Postgres (admin scripts, CREATE DATABASE, tenant provisioning) ---
POSTGRES_DIRECT_HOST=alm_db
POSTGRES_DIRECT_PORT=5432
POSTGRES_DIRECT_URL=postgresql://USER:PASSWORD@alm_db:5432/postgres?sslmode=disable

# --- App traffic (enable PgBouncer with ./scripts/db/enable-pgbouncer-main.sh) ---
PGBOUNCER_ENABLED=false
PGBOUNCER_HOST=alm_pgbouncer
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=25
PGBOUNCER_MIN_POOL_SIZE=2
PGBOUNCER_RESERVE_POOL_SIZE=5

# Before PgBouncer: point at alm_db:5432
# After enable-pgbouncer-main.sh: point at alm_pgbouncer:6432
DATABASE_URL=postgresql://USER:PASSWORD@alm_db:5432/hospitality?sslmode=disable
TENANT_DATABASE_URL=postgresql://USER:PASSWORD@alm_db:5432/postgres?sslmode=disable
GENERIC_URL=postgresql://USER:PASSWORD@alm_db:5432/assetLifecycle?sslmode=disable
JWT_SECRET=replace-with-strong-secret

# Redis — Docker Compose service name (alm-redis → hostname alm_redis)
CACHE_ENABLED=true
REDIS_URL=redis://alm_redis:6379/0
AUTH_CACHE_TTL_MS=120000
TENANT_EXISTS_CACHE_TTL_MS=300000
DASHBOARD_CACHE_TTL_MS=180000
ASSETS_LIST_CACHE_TTL_MS=120000
ASSIGNMENT_CACHE_TTL_MS=180000
SCRAP_APPROVAL_CACHE_TTL_MS=180000
MAINTENANCE_SUPERVISOR_CACHE_TTL_MS=180000

# Database pools — with PgBouncer use smaller Node pools (PgBouncer holds real PG connections)
DB_POOL_MAX=10
DB_POOL_MIN=0
TENANT_REGISTRY_POOL_MAX=5
TENANT_DB_POOL_MAX=3

# Behind nginx on host (proxy to container port 5002)
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Rate limiting (per client IP)
RATE_LIMIT_MAX_PER_MIN=300
AUTH_RATE_LIMIT_MAX_PER_15MIN=30

# --- Zoho Directory OIDC SSO (optional; password login + tenant-setup unchanged) ---
# Set ZOHO_OIDC_ENABLED=true only after filling client id/secret.
ZOHO_OIDC_ENABLED=false
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://rioassetmanagement.net/api/auth/zoho/callback
# Optional — defaults to your RIO EAM Zoho Directory endpoints if omitted
ZOHO_AUTHORIZATION_ENDPOINT=https://directory.zoho.in/p/60084560311/app/514401000000006001/sso/authorize
ZOHO_TOKEN_ENDPOINT=https://directory.zoho.in/p/60084560311/app/514401000000006001/sso/token
ZOHO_USERINFO_ENDPOINT=https://directory.zoho.in/p/60084560311/app/514401000000006001/sso/userinfo
# Aliases also accepted: ZOHO_AUTHORIZE_URL / ZOHO_TOKEN_URL / ZOHO_USERINFO_URL
ZOHO_SCOPES=openid email profile
# Where to send users on SSO errors (root/platform frontend)
SSO_PLATFORM_FRONTEND_URL=https://rioassetmanagement.net

# Zoho access requests (company ops only — not tenant JR001)
# Required to unlock https://rioassetmanagement.net/ops/access-requests
ACCESS_REQUEST_OPS_PASSWORD=replace-with-strong-ops-password
# Who gets email when a Zoho user submits a request
ACCESS_REQUEST_NOTIFY_EMAILS=ops@yourcompany.com

# Firebase Cloud Messaging (optional — API still boots if unset)
# Docker Compose loads THIS file (.env.production), not .env
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

