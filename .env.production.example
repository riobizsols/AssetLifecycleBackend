# Copy to .env.production and fill all values
# Bannari org stack — https://bannari.rioassetmanagement.net
NODE_ENV=production
PORT=5001

# Domain setup
MAIN_DOMAIN=rioassetmanagement.net
FRONTEND_URL=https://bannari.rioassetmanagement.net
BACKEND_URL=https://bannari.rioassetmanagement.net
API_BASE_URL=https://bannari.rioassetmanagement.net/api

# Subdomains tenants cannot register (kept in sync with tenant ALM)
RESERVED_SUBDOMAINS=web,www,api,pressanaorg,bannari

# Required app secrets/infra
# Docker Postgres (alm_db) does not use SSL — always add ?sslmode=disable
# Or set DB_SSL=false explicitly
DB_SSL=false
# Bannari org app DB (NOT hospitality / tenant wildcard DBs)
DATABASE_URL=postgresql://USER:PASSWORD@alm_db:5432/bannari_db?sslmode=disable
TENANT_DATABASE_URL=postgresql://USER:PASSWORD@alm_db:5432/postgres?sslmode=disable
GENERIC_URL=postgresql://USER:PASSWORD@alm_db:5432/assetLifecycle?sslmode=disable
JWT_SECRET=replace-with-strong-secret

# Redis — shared alm_redis on alm-shared (do not start a second Redis)
CACHE_ENABLED=true
REDIS_URL=redis://alm_redis:6379/0
AUTH_CACHE_TTL_MS=120000
TENANT_EXISTS_CACHE_TTL_MS=300000
DASHBOARD_CACHE_TTL_MS=180000
ASSETS_LIST_CACHE_TTL_MS=120000
ASSIGNMENT_CACHE_TTL_MS=180000
SCRAP_APPROVAL_CACHE_TTL_MS=180000
MAINTENANCE_SUPERVISOR_CACHE_TTL_MS=180000

# Database pools — single Docker container (one Node process)
DB_POOL_MAX=20
DB_POOL_MIN=2
TENANT_REGISTRY_POOL_MAX=10
TENANT_DB_POOL_MAX=5

# Behind nginx on host (proxy to container host port 5004)
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Rate limiting (per client IP)
RATE_LIMIT_MAX_PER_MIN=300
AUTH_RATE_LIMIT_MAX_PER_15MIN=30

# MinIO — separate bucket from main/tenant
MINIO_END_POINT=mansoor-minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=alm-bannari
